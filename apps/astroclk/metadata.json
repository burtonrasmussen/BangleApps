{
  "id": "astroclk",
  "name": "AstroWatch",
  "shortName": "AstroWatch",
  "version": "0.06",
  "description": "Astronomy-focused watch face with moon phase, sky conditions, and weather forecast. Fetches weather data from phone via Gadgetbridge.",
  "icon": "app.png",
  "type": "clock",
  "tags": "clock,astronomy,moon,weather,sky",
  "supports": ["BANGLEJS2"],
  "allow_emulator": false,
  "readme": "README.md",
  "interface": "interface.html",
  "dependencies": {
    "mylocation": "app",
    "android": "app"
  },
  "storage": [
    {"name": "astroclk.app.js",       "url": "app.js"},
    {"name": "astroclk.boot.js",      "url": "boot.js"},
    {"name": "astroclk.settings.js",  "url": "settings.js"},
    {"name": "astroclk.fetch.js",     "url": "fetch.js"},
    {"name": "FontVGA16",             "url": "FontVGA16.js"},
    {"name": "astroclk.img",          "url": "app-icon.js", "evaluate": true}
  ],
  "data": [
    {"name": "astroclk.json"},
    {"name": "astroclk.sync.json"},
    {"name": "astroclk.weather.json"},
    {"name": "astroclk.log.json"}
  ]
}
